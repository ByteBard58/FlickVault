DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# SUPABASE_KEY also works if Supabase labels your anon key that way.
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=RS256,ES256

# Local-only escape hatch. Do not set this in production.
AUTH_DISABLED=false
DEV_USER_ID=local-dev-user
